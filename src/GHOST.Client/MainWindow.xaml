<Window x:Class="GHOST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHOST // Investigation Lab"
        Height="820" Width="1360" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource HackerFont}">
    <Window.Resources>
        <DataTemplate x:Key="RecentCaseTemplate">
            <Border Margin="1,3" Padding="9"
                    Background="#0A1016" BorderBrush="#1E2B36"
                    BorderThickness="1" CornerRadius="8" MinHeight="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Width="74" Padding="6,7"
                            Background="#12242D" BorderBrush="#2A4B55"
                            BorderThickness="1" CornerRadius="6"
                            VerticalAlignment="Stretch" Margin="0,0,10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CASE FILE" FontSize="7"
                                       Foreground="#8195A1"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CaseNumber}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource NeonBrush}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding Title}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Grid.Row="1"
                                Orientation="Horizontal" Margin="0,6,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="CREATED" FontSize="7"
                                   Foreground="#80929F" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CreatedAt}" FontSize="8"
                                   Foreground="#B2C0CD" Margin="7,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="2" Grid.RowSpan="2"
                            Background="#13242D" BorderBrush="#2A4B55"
                            BorderThickness="1" CornerRadius="5"
                            Padding="9,6" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="7"
                                       Foreground="#8195A1"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" FontSize="9"
                                       FontWeight="SemiBold" Foreground="{StaticResource NeonBrush}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="RecentCaseItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="SelectionChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#36545F" />
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#101A22" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#74E6B7" />
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#12242D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="254" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="16,18,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10"
                                Background="#121F28" BorderBrush="#3F7077"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <Ellipse Width="27" Height="27" Stroke="{StaticResource NeonBrush}"
                                         StrokeThickness="1.2" />
                                <TextBlock Text="G" FontSize="21" Foreground="{StaticResource NeonBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="GHOST" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="INVESTIGATION OS" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18" />
                    <Border Background="#101720" BorderBrush="#283943" BorderThickness="1"
                            CornerRadius="6" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource NeonBrush}"
                                     Margin="0,0,9,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#74E6B7" BlurRadius="9" ShadowDepth="0" Opacity="0.75" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="LOCAL SESSION ACTIVE" FontSize="9"
                                       Foreground="{StaticResource NeonBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" />
                    <Border Background="#10171F" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="WORKSTATION STATUS" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,7">
                                <TextBlock Text="●" Foreground="{StaticResource NeonBrush}" FontSize="10"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="LOCAL STORAGE READY" Foreground="{StaticResource TextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <TextBlock Text="●" Foreground="{StaticResource CyanBrush}" FontSize="10"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="NETWORK ISOLATED" Foreground="{StaticResource TextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <TextBlock Text="ENCRYPTION: NOT CONFIGURED" FontSize="8"
                                       Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Every trace tells a story." FontStyle="Italic" FontSize="9"
                               Foreground="{StaticResource MutedBrush}" Margin="3,14,0,0" />
                    <TextBlock Text="GHOST / BUILD 0.2" FontSize="8"
                               Foreground="#52695A" Margin="3,5,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="5,2,4,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="03 MODULES" FontSize="7"
                                       Foreground="#526675" VerticalAlignment="Center" />
                        </Grid>

                        <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}"
                                Click="Dashboard_Click">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7"
                                        Background="#0D1920" BorderBrush="#29414B" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"
                                          Fill="#74E6B7" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Stretch="Uniform" Width="17" Height="17" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="DASHBOARD" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    <TextBlock Text="System overview" FontSize="7"
                                               Foreground="#82939F" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="01" FontSize="7"
                                           Foreground="#526675" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavCases" Style="{StaticResource NavButtonStyle}"
                                Click="Cases_Click">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7"
                                        Background="#0D1920" BorderBrush="#29414B" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path Data="M3,8 L3,5 L9,5 L11,8 L21,8 L21,19 L3,19 Z"
                                          Stroke="#74E6B7" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" Fill="#17352E"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stretch="Uniform" Width="18" Height="18" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="CASE FILES" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    <TextBlock Text="Records &amp; evidence" FontSize="7"
                                               Foreground="#82939F" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="02" FontSize="7"
                                           Foreground="#526675" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="NavNetwork" Style="{StaticResource NavButtonStyle}"
                                Click="Network_Click">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7"
                                        Background="#0D1920" BorderBrush="#29414B" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Canvas Width="19" Height="19">
                                        <Path Data="M9.5,3.5 L3.5,15.5 M9.5,3.5 L15.5,15.5 M3.5,15.5 L15.5,15.5"
                                              Stroke="#74E6B7" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Canvas.Left="6.5" Canvas.Top="0.5" Width="6" Height="6"
                                                 Fill="#74E6B7" />
                                        <Ellipse Canvas.Left="0.5" Canvas.Top="13" Width="6" Height="6"
                                                 Fill="#74E6B7" />
                                        <Ellipse Canvas.Left="12.5" Canvas.Top="13" Width="6" Height="6"
                                                 Fill="#74E6B7" />
                                    </Canvas>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="INVESTIGATION NETWORK" FontSize="8" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    <TextBlock Text="Connections &amp; timeline" FontSize="7"
                                               Foreground="#82939F" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="03" FontSize="7"
                                           Foreground="#526675" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="#1D2B35" Margin="5,17,5,15" />
                        <Grid Margin="5,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOOLS" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="01 UTILITY" FontSize="7"
                                       Foreground="#526675" VerticalAlignment="Center" />
                        </Grid>

                        <Button x:Name="NavTerminal" Style="{StaticResource NavButtonStyle}"
                                Click="Terminal_Click">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7"
                                        Background="#0D1920" BorderBrush="#29414B" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path Data="M4,5 L11,10 L4,15 M12.5,15 H19"
                                          Stroke="#74E6B7" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stretch="Uniform" Width="19" Height="19" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="GHOST TERMINAL" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    <TextBlock Text="PowerShell console" FontSize="7"
                                               Foreground="#82939F" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="PS" FontSize="7"
                                           Foreground="#58C9D8" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid x:Name="DashboardView" Grid.Column="1" Margin="24,18,24,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,5,0">
                <StackPanel>

                    <!-- DASHBOARD HEADER -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GHOST  /  INVESTIGATION OPERATIONS"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock x:Name="PageTitle" Text="Dashboard"
                                       FontSize="26" FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                            <TextBlock x:Name="PageEyebrow"
                                       Text="PRIVATE INVESTIGATION WORKSPACE"
                                       Visibility="Collapsed" />
                            <TextBlock Text="Your workspace, system health, and latest investigation activity."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="7"
                                    Padding="10,8" Margin="0,0,9,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="LOCAL / OFFLINE" FontSize="8"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="#0B1710" BorderBrush="#294B35"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="9,6" Margin="0,0,9,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="28" CornerRadius="6"
                                            Background="#13242D" BorderBrush="#28583A"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="◷" FontSize="18" Foreground="#74E6B7"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="LOCAL TIME" FontSize="7"
                                                   Foreground="#72977D" />
                                        <TextBlock x:Name="ClockText" Text="00:00:00"
                                                   FontFamily="Consolas" FontSize="14"
                                                   FontWeight="Bold" Foreground="#74E6B7" />
                                        <TextBlock x:Name="ClockDateText" Text="MON, 01 JAN 2026"
                                                   FontSize="7" Foreground="#9BB8A4" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button Content="+ NEW CASE" Click="NewCase_Click"
                                    Padding="14,11" FontSize="9" />
                        </StackPanel>
                    </Grid>

                    <!-- LIVE SYSTEM OVERVIEW -->
                    <Border Background="#081711" BorderBrush="#244B35"
                            BorderThickness="1" CornerRadius="11"
                            ClipToBounds="True" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#74E6B7" />
                            <Grid Grid.Row="1" MinHeight="150">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Margin="12,13,8,0">
                                        <Ellipse Width="7" Height="7" Fill="#74E6B7"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#74E6B7"
                                                                  BlurRadius="9"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.7" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="LIVE SYSTEM TELEMETRY"
                                                   FontSize="8" FontWeight="SemiBold"
                                                   Foreground="#9DFFC1" />
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center"
                                                Margin="18,23,14,8">
                                        <TextBlock Text="System Health"
                                                   FontSize="19" FontWeight="Bold"
                                                   Foreground="#F1F7FC" />
                                        <Border Background="#0B1B12"
                                                BorderBrush="#28533A"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30"
                                                        CornerRadius="7"
                                                        Background="#142B1D"
                                                        BorderBrush="#315C40"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Grid Width="17" Height="17">
                                                        <Ellipse Width="15" Height="15"
                                                                 Stroke="#74E6B7"
                                                                 StrokeThickness="1.2"
                                                                 Opacity="0.9" />
                                                        <Path Data="M8.5,3.5 L8.5,8.5 L12,10.5"
                                                              Stroke="#74E6B7"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0">
                                                    <TextBlock Text="SYSTEM UPTIME"
                                                               FontSize="7"
                                                               FontWeight="SemiBold"
                                                               Foreground="#86B398" />
                                                    <TextBlock x:Name="SystemUptimeText"
                                                               Text="--"
                                                               FontFamily="Consolas"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="#74E6B7"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="1" Margin="0,13,13,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#0C1D14"
                                            BorderBrush="#21442E" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,8,0" Padding="11,9">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PROCESSOR" FontSize="8"
                                                       Foreground="#9DFFC1" />
                                            <TextBlock x:Name="CpuUsageText" Text="--%"
                                                       FontSize="25" FontWeight="SemiBold"
                                                       Foreground="#74E6B7" Margin="0,3,0,2" />
                                            <Grid Height="30" ClipToBounds="True">
                                                <Rectangle Height="1" Fill="#1C3B29"
                                                           VerticalAlignment="Center" />
                                                <Path x:Name="CpuUsageSparklineFill"
                                                      Stretch="Fill" Fill="#1D7A49"
                                                      Opacity="0.42" StrokeThickness="0"
                                                      Data="M 0,34 L 100,34 Z" />
                                                <Path x:Name="CpuUsageSparklineGlow"
                                                      Stretch="Fill" Stroke="#35FF95"
                                                      StrokeThickness="4" Opacity="0.20"
                                                      Data="M 0,17 L 100,17" />
                                                <Path x:Name="CpuUsageSparkline"
                                                      Stretch="Fill" Stroke="#74E6B7"
                                                      StrokeThickness="1.7"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 0,17 L 100,17" />
                                            </Grid>
                                            <TextBlock x:Name="CpuUsageDetailText"
                                                       Text="Sampling CPU activity..."
                                                       FontSize="7" Foreground="#88AB94"
                                                       Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0C1D14"
                                            BorderBrush="#21442E" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,8,0" Padding="11,9">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="MEMORY / RAM" FontSize="8"
                                                       Foreground="#9DFFC1" />
                                            <TextBlock x:Name="MemoryUsageText" Text="--%"
                                                       FontSize="25" FontWeight="SemiBold"
                                                       Foreground="#74E6B7" Margin="0,3,0,2" />
                                            <Grid Height="30" ClipToBounds="True">
                                                <Rectangle Height="1" Fill="#1C3B29"
                                                           VerticalAlignment="Center" />
                                                <Path x:Name="MemoryUsageSparklineFill"
                                                      Stretch="Fill" Fill="#1D7A49"
                                                      Opacity="0.42" StrokeThickness="0"
                                                      Data="M 0,34 L 100,34 Z" />
                                                <Path x:Name="MemoryUsageSparklineGlow"
                                                      Stretch="Fill" Stroke="#35FF95"
                                                      StrokeThickness="4" Opacity="0.20"
                                                      Data="M 0,17 L 100,17" />
                                                <Path x:Name="MemoryUsageSparkline"
                                                      Stretch="Fill" Stroke="#74E6B7"
                                                      StrokeThickness="1.7"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 0,17 L 100,17" />
                                            </Grid>
                                            <TextBlock x:Name="MemoryUsageDetailText"
                                                       Text="Reading physical memory..."
                                                       FontSize="7" Foreground="#88AB94"
                                                       Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#0C1D14"
                                            BorderBrush="#21442E" BorderThickness="1"
                                            CornerRadius="8" Padding="11,9">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SYSTEM DRIVE" FontSize="8"
                                                       Foreground="#9DFFC1" />
                                            <TextBlock x:Name="DiskUsageText" Text="--%"
                                                       FontSize="25" FontWeight="SemiBold"
                                                       Foreground="#74E6B7" Margin="0,3,0,2" />
                                            <Grid Height="30" ClipToBounds="True">
                                                <Rectangle Height="1" Fill="#1C3B29"
                                                           VerticalAlignment="Center" />
                                                <Path x:Name="DiskUsageSparklineFill"
                                                      Stretch="Fill" Fill="#1D7A49"
                                                      Opacity="0.42" StrokeThickness="0"
                                                      Data="M 0,34 L 100,34 Z" />
                                                <Path x:Name="DiskUsageSparklineGlow"
                                                      Stretch="Fill" Stroke="#35FF95"
                                                      StrokeThickness="4" Opacity="0.20"
                                                      Data="M 0,17 L 100,17" />
                                                <Path x:Name="DiskUsageSparkline"
                                                      Stretch="Fill" Stroke="#74E6B7"
                                                      StrokeThickness="1.7"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 0,17 L 100,17" />
                                            </Grid>
                                            <TextBlock x:Name="DiskUsageDetailText"
                                                       Text="Reading system drive..."
                                                       FontSize="7" Foreground="#88AB94"
                                                       Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- INVESTIGATION METRICS -->
                    <Grid Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="1,0,1,8">
                            <TextBlock Text="INVESTIGATION OVERVIEW" FontSize="9"
                                       FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="LIVE LOCAL RECORDS"
                                       HorizontalAlignment="Right" FontSize="7"
                                       Foreground="#526675" />
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="5">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OPEN CASES" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="CasesCount" Text="0"
                                               FontSize="27" FontWeight="SemiBold"
                                               Foreground="{StaticResource NeonBrush}"
                                               Margin="0,4,0,1" />
                                    <TextBlock Text="ACTIVE INVESTIGATIONS"
                                               FontSize="7" Foreground="#718878" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CLOSED CASES" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="ClosedCasesCount" Text="0"
                                               FontSize="27" FontWeight="SemiBold"
                                               Foreground="#FF7A83" Margin="0,4,0,1" />
                                    <TextBlock Text="COMPLETED INVESTIGATIONS"
                                               FontSize="7" Foreground="#B97980" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL CASES" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TotalCasesCount" Text="0"
                                               FontSize="27" FontWeight="SemiBold"
                                               Foreground="#87BFFF" Margin="0,4,0,1" />
                                    <TextBlock Text="ALL INVESTIGATIONS"
                                               FontSize="7" Foreground="#8299B5" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="EXPERIMENTS" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="ExperimentsCount" Text="0"
                                               FontSize="27" FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}"
                                               Margin="0,4,0,1" />
                                    <TextBlock Text="RECORDED PROCEDURES"
                                               FontSize="7" Foreground="#718878" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="EVIDENCE ITEMS" FontSize="8"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="EvidenceCount" Text="0"
                                               FontSize="27" FontWeight="SemiBold"
                                               Foreground="#D8E98A" Margin="0,4,0,1" />
                                    <TextBlock Text="SAVED RECORDS"
                                               FontSize="7" Foreground="#A6A77A" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <!-- RECENT INVESTIGATIONS + COMMAND DECK -->
                    <Grid MinHeight="365" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.02*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- RECENT CASES -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="13" Margin="0,0,10,0">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="1,0,1,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="INVESTIGATION ACTIVITY" FontSize="8"
                                                   Foreground="#879AA8" />
                                        <TextBlock Text="Recent case files" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="Your latest saved investigations."
                                                   FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button x:Name="OpenRecentCaseButton"
                                                Content="OPEN SELECTED"
                                                Click="OpenRecentCase_Click"
                                                IsEnabled="False"
                                                Style="{StaticResource NavButtonStyle}"
                                                Padding="8,6" Margin="0,0,6,0"
                                                FontSize="7" />
                                        <Button Content="VIEW ALL  →"
                                                Style="{StaticResource NavButtonStyle}"
                                                Click="Cases_Click" Padding="8,6"
                                                Margin="0" FontSize="7" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <ListBox x:Name="RecentCasesList"
                                             ItemTemplate="{StaticResource RecentCaseTemplate}"
                                             ItemContainerStyle="{StaticResource RecentCaseItemStyle}"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="RecentCasesList_SelectionChanged"
                                             MouseDoubleClick="RecentCase_DoubleClick" />
                                    <StackPanel x:Name="EmptyCasesHint"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <TextBlock Text="NO CASES YET" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Create an investigation to populate this space."
                                                   FontSize="8" Foreground="#788A97"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- GHOST COMMAND DECK -->
                        <Border Grid.Column="1" Background="#030609"
                                BorderBrush="#25505A" BorderThickness="1"
                                CornerRadius="10" Padding="0" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#43CFE0" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.10" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#0D170F"
                                        BorderBrush="#285337" BorderThickness="0,0,0,1">
                                    <Grid Margin="11,1,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <Ellipse Width="7" Height="7" Fill="#74E6B7"
                                                     Margin="0,0,4,0" />
                                            <Ellipse Width="7" Height="7" Fill="#36734A"
                                                     Margin="0,0,4,0" />
                                            <Ellipse Width="7" Height="7" Fill="#244B31" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="GHOST // COMMAND DECK"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#D6FFE0" />
                                            <TextBlock x:Name="DashboardConsoleHostText"
                                                       Text="LOCAL SESSION / INITIALIZING"
                                                       FontSize="7" Foreground="#6F9D7B"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Background="#13242D" BorderBrush="#2A4B55"
                                                    BorderThickness="1" CornerRadius="3"
                                                    Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="DashboardConsoleStatusText"
                                                           Text="STARTING" FontSize="7"
                                                           Foreground="#74E6B7" />
                                            </Border>
                                            <Button Content="↻" Click="DashboardConsoleRestart_Click"
                                                    Padding="6,3" FontSize="9" Margin="5,0,0,0"
                                                    Background="#13242D" BorderBrush="#34764B"
                                                    Foreground="#B5FFC8"
                                                    ToolTip="Restart PowerShell session" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#071009"
                                        BorderBrush="#142D1B" BorderThickness="0,0,0,1"
                                        Padding="7,1">
                                    <DockPanel LastChildFill="False"
                                               VerticalAlignment="Center">
                                        <TextBlock Text="QUICK RUN" FontSize="7"
                                                   FontWeight="Bold" Foreground="#5F8F6C"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,7,0" />
                                        <Button Content="PWD" Tag="Get-Location"
                                                Click="DashboardConsoleQuickCommand_Click"
                                                Padding="6,2" FontSize="7" Margin="2,0"
                                                Background="#0D1C11" BorderBrush="#244B30"
                                                Foreground="#9DFFC1" />
                                        <Button Content="PROCESSES"
                                                Tag="Get-Process | Select-Object -First 5"
                                                Click="DashboardConsoleQuickCommand_Click"
                                                Padding="6,2" FontSize="7" Margin="2,0"
                                                Background="#0D1C11" BorderBrush="#244B30"
                                                Foreground="#9DFFC1" />
                                        <Button Content="FILES"
                                                Tag="Get-ChildItem -Force | Select-Object -First 8"
                                                Click="DashboardConsoleQuickCommand_Click"
                                                Padding="6,2" FontSize="7" Margin="2,0"
                                                Background="#0D1C11" BorderBrush="#244B30"
                                                Foreground="#9DFFC1" />
                                        <Button Content="PS INFO" Tag="$PSVersionTable"
                                                Click="DashboardConsoleQuickCommand_Click"
                                                Padding="6,2" FontSize="7" Margin="2,0"
                                                Background="#0D1C11" BorderBrush="#244B30"
                                                Foreground="#9DFFC1" />
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="2" Background="#030609">
                                    <Border Background="{StaticResource DotGridBrush}"
                                            Opacity="0.10" IsHitTestVisible="False" />
                                    <ScrollViewer x:Name="DashboardConsoleScrollViewer"
                                                  Background="Transparent"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="DashboardConsoleOutputPanel"
                                                    Margin="11,8,9,3" />
                                    </ScrollViewer>
                                </Grid>

                                <Border Grid.Row="3" Background="#0A140D"
                                        BorderBrush="#2A5738" BorderThickness="0,1,0,0"
                                        Padding="9,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DashboardConsolePromptText"
                                                   Text="PS&gt;" FontSize="10"
                                                   FontWeight="Bold" Foreground="#74E6B7"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBox x:Name="DashboardConsoleInput" Grid.Column="1"
                                                 Height="28" Padding="7,4"
                                                 Background="#030609" BorderBrush="#25472E"
                                                 BorderThickness="1" Foreground="#C8F8D4"
                                                 CaretBrush="#74E6B7" FontSize="9"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Run PowerShell commands in your local Windows session."
                                                 PreviewKeyDown="DashboardConsoleInput_KeyDown" />
                                        <Button Grid.Column="2" Content="RUN  ↵"
                                                Click="DashboardConsoleRun_Click"
                                                Padding="8,5" FontSize="8"
                                                Margin="6,0,0,0" Background="#13242D"
                                                BorderBrush="#2C6840"
                                                Foreground="#8FFFB1" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="4" Background="#071009" Padding="10,1">
                                    <DockPanel>
                                        <TextBlock Text="●" FontSize="7"
                                                   Foreground="#74E6B7"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <TextBlock Text="NATIVE POWERSHELL  //  PERSISTENT SESSION"
                                                   FontSize="7" Foreground="#6F9D7B"
                                                   VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="GHOST / PS"
                                                   FontSize="7" Foreground="#3E6849"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    <Grid x:Name="NetworkView" Grid.Column="1" Margin="26,20,26,22" Visibility="Collapsed">
        <Grid.Resources>
        <DataTemplate x:Key="ConnectionTemplate">
            <Border Background="#0D1711" BorderBrush="#263E30" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,7">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RelationshipType}" FontSize="9"
                                   Foreground="{StaticResource NeonBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" FontSize="8"
                                   Foreground="{StaticResource CyanBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding SourceLabel}" FontSize="9"
                               Foreground="{StaticResource TextBrush}" Margin="0,7,0,2"
                               TextWrapping="Wrap" />
                    <TextBlock Text="↓" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TargetLabel}" FontSize="9"
                               Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DescriptionPreview}" FontSize="8"
                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GHOST / WORKSPACE / VISUAL ANALYSIS" FontSize="9"
                           Foreground="{StaticResource NeonBrush}" />
                <TextBlock Text="Investigation Network" FontSize="23"
                           FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="LOCAL DATA" FontSize="9"
                                   Foreground="{StaticResource CyanBrush}" />
                    </StackPanel>
                </Border>
                <Button Content="↻ REFRESH" Click="Refresh_Click" Margin="0,0,8,0" />
                <Button x:Name="NewRelationshipButton" Content="+ CREATE CONNECTION"
                        Click="NewRelationship_Click" Margin="0,0,8,0" />
                <Button Content="← DASHBOARD" Click="Dashboard_Click" />
            </StackPanel>
        </Grid>

        <!-- NETWORK AND RIGHT SIDEBAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <!-- GRAPH VIEW -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="16" Margin="0,0,13,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RELATIONSHIP MAP" FontSize="10"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="Nodes are loaded from your saved case and evidence records."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Background="#13241A" BorderBrush="#31543B" BorderThickness="1"
                                    CornerRadius="5" Padding="8,5" Margin="0,0,7,0">
                                <TextBlock x:Name="NodesCountText" Text="NODES // 0" FontSize="8"
                                           Foreground="{StaticResource NeonBrush}" />
                            </Border>
                            <Border Background="#132126" BorderBrush="#2A5360" BorderThickness="1"
                                    CornerRadius="5" Padding="8,5">
                                <TextBlock x:Name="RelationshipsCountText" Text="LINKS // 0" FontSize="8"
                                           Foreground="{StaticResource CyanBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GraphSearchBox" Height="34"
                                 ToolTip="Search node title, ID, record type, or details"
                                 TextChanged="GraphFilter_Changed"
                                 Margin="0,0,8,0" />
                        <ComboBox x:Name="GraphTypeFilter" Grid.Column="1" Height="34"
                                  SelectionChanged="GraphFilter_Changed"
                                  Margin="0,0,8,0">
                            <ComboBoxItem Content="All record types" IsSelected="True" />
                            <ComboBoxItem Content="Cases" />
                            <ComboBoxItem Content="Evidence" />
                            <ComboBoxItem Content="Experiments" />
                            <ComboBoxItem Content="Observations" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="−" Width="38" ToolTip="Zoom out"
                                    Click="GraphZoomOut_Click" Margin="0,0,5,0" />
                            <Button Content="FIT" MinWidth="52" ToolTip="Fit graph to view"
                                    Click="GraphFit_Click" Margin="0,0,5,0" />
                            <Button Content="+" Width="38" ToolTip="Zoom in"
                                    Click="GraphZoomIn_Click" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#08110C" BorderBrush="#1D3024" BorderThickness="1"
                            CornerRadius="7" Padding="4">
                        <Grid>
                            <ScrollViewer x:Name="GraphScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="GraphCanvas" Width="1100" Height="600"
                                        Background="{StaticResource DotGridBrush}" />
                            </ScrollViewer>
                            <Border x:Name="EmptyGraphOverlay" Background="#E008110C"
                                    CornerRadius="6" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="390">
                                    <TextBlock x:Name="GraphEmptyTitle" Text="NO INVESTIGATION NODES" FontSize="12"
                                               Foreground="{StaticResource NeonBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Create case records from the Dashboard first. They will appear here automatically. As more evidence and experiments are added, they can be connected into your map."
                                               FontSize="9" Foreground="{StaticResource MutedBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Margin="0,11,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- CONTROLS AND SAVED LINKS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SELECTED NODE" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="SelectedNodeTitle" Text="Select a node on the map"
                                   FontSize="12" Foreground="{StaticResource NeonBrush}"
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock x:Name="SelectedNodeDetails"
                                   Text="Click a node to inspect its local record."
                                   FontSize="8" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14" />
                        <Button x:Name="OpenSelectedNodeButton" Content="OPEN SELECTED RECORD"
                                Click="OpenSelectedNode_Click" IsEnabled="False"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HOW THIS MAP WORKS" FontSize="9"
                                   Foreground="{StaticResource NeonBrush}" />
                        <TextBlock Text="Create connections between saved records. Relationship type, notes, and confidence are kept locally. Dashed links represent a hypothesis or contradiction."
                                   FontSize="8" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="14" />
                    </StackPanel>
                </Border>

                <!-- INLINE CONNECTION EDITOR: stays inside the main application window -->
                <Border x:Name="CreateConnectionPanel" Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#31543B" BorderThickness="1"
                        CornerRadius="8" Padding="13" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="CREATE CONNECTION" FontSize="9"
                                   Foreground="{StaticResource NeonBrush}" />
                        <TextBlock Text="Connect two records. A link represents an investigator-created assertion, not automatic proof."
                                   FontSize="8" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,9" />
                        <TextBlock Text="SOURCE RECORD" FontSize="8" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="SourceRecordComboBox" Height="32"
                                  DisplayMemberPath="DisplayText" FontSize="9"
                                  Margin="0,3,0,7" />
                        <TextBlock Text="TARGET RECORD" FontSize="8" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="TargetRecordComboBox" Height="32"
                                  DisplayMemberPath="DisplayText" FontSize="9"
                                  Margin="0,3,0,7" />
                        <TextBlock Text="RELATIONSHIP TYPE" FontSize="8" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="RelationshipTypeComboBox" Height="32"
                                  SelectedIndex="0" FontSize="9" Margin="0,3,0,7">
                            <ComboBoxItem Content="Related to" />
                            <ComboBoxItem Content="Supports" />
                            <ComboBoxItem Content="Contradicts" />
                            <ComboBoxItem Content="Derived from" />
                            <ComboBoxItem Content="Part of" />
                            <ComboBoxItem Content="Same source" />
                            <ComboBoxItem Content="Observed with" />
                            <ComboBoxItem Content="Hypothesis" />
                        </ComboBox>
                        <TextBlock Text="NOTES / SOURCE / REASONING" FontSize="8"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="RelationshipNotesTextBox" Height="55"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="9"
                                 Margin="0,3,0,7" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONFIDENCE (INVESTIGATOR ESTIMATE)" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ConfidenceValueText" Grid.Column="1"
                                       Text="80%" FontSize="9"
                                       Foreground="{StaticResource CyanBrush}" />
                        </Grid>
                        <Slider x:Name="ConfidenceSlider" Minimum="0" Maximum="1" Value="0.8"
                                TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_ValueChanged" />
                        <TextBlock x:Name="CreateConnectionStatus" FontSize="8"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="0,3,0,5" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Width="82" Click="CancelRelationship_Click"
                                    Margin="0,0,7,0" />
                            <Button Content="SAVE CONNECTION" Width="145"
                                    Click="SaveRelationship_Click" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                            <TextBlock Text="SAVED CONNECTIONS" FontSize="9"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="Select a connection to inspect its notes."
                                       FontSize="8" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid>
                            <ListBox x:Name="ConnectionsList"
                                     ItemTemplate="{StaticResource ConnectionTemplate}"
                                     SelectionChanged="ConnectionsList_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" />
                            <TextBlock x:Name="EmptyConnectionsHint"
                                       Text="No connections yet. Use CREATE CONNECTION to link two records."
                                       FontSize="8" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="8" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Button x:Name="DeleteConnectionButton" Grid.Row="4"
                        Content="DELETE SELECTED CONNECTION" Click="DeleteConnection_Click"
                        IsEnabled="False" Background="#2B1414" Foreground="#FFAAAA"
                        BorderBrush="#633737" Padding="12,10" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
    <Grid x:Name="ModuleView" Grid.Column="1" Margin="26,20,26,22" Visibility="Collapsed">
        <ContentControl x:Name="ModuleContent" />
    </Grid>
    </Grid>
</Window>
