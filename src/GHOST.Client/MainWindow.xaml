<Window x:Class="GHOST.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GHOST // Investigation Lab" Height="850" Width="1440" MinHeight="680" MinWidth="1120" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="#E7F5EB">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0B100E" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,28"><TextBlock Text="GHOST" FontSize="28" FontWeight="Bold" Foreground="{StaticResource NeonBrush}"/><TextBlock Text="INVESTIGATION LAB // 1.0" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="2,4,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12"/><TextBlock Text="LOCAL MODE  ●  ENCRYPTION: NOT CONFIGURED" FontSize="9" Foreground="#E5B567" TextWrapping="Wrap"/><TextBlock Text="Every trace tells a story." FontStyle="Italic" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel>
    <StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="4,0,0,8"/>
     <Button Content="▦   COMMAND CENTER" Click="Dashboard_Click" HorizontalContentAlignment="Left"/>
     <Button Content="▤   CASE FILES" Click="Cases_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⌕   DIGITAL LAB" Click="ComingSoon_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⚗   FIELD LAB" Click="ComingSoon_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⬡   EVIDENCE VAULT" Click="ComingSoon_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⌘   INTELLIGENCE BOARD" Click="Board_Click" HorizontalContentAlignment="Left"/>
     <Button Content="&gt;_   GHOST TERMINAL" Click="Terminal_Click" HorizontalContentAlignment="Left"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageEyebrow" Text="SYSTEM OVERVIEW / LOCAL INSTANCE" Foreground="{StaticResource NeonBrush}" FontSize="10"/><TextBlock x:Name="PageTitle" Text="Command Center" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,8,0"><TextBlock x:Name="ClockText" Text="OFFLINE MODE" FontSize="10" Foreground="{StaticResource NeonBrush}"/></Border><Button Content="+ NEW CASE" Click="NewCase_Click"/></StackPanel></Grid>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="OPEN CASES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="CasesCount" Text="0" FontSize="30" Foreground="{StaticResource NeonBrush}" Margin="0,8,0,0"/><TextBlock Text="LOCAL RECORDS" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="EXPERIMENTS" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ExperimentsCount" Text="0" FontSize="30" Foreground="{StaticResource NeonBrush}" Margin="0,8,0,0"/><TextBlock Text="ALL CATEGORIES" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="EVIDENCE ITEMS" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="EvidenceCount" Text="0" FontSize="30" Foreground="{StaticResource NeonBrush}" Margin="0,8,0,0"/><TextBlock Text="HASH-TRACKED FILES" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="16"><StackPanel><TextBlock Text="LINKED CLUES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="LinksCount" Text="0" FontSize="30" Foreground="{StaticResource NeonBrush}" Margin="0,8,0,0"/><TextBlock Text="INVESTIGATION GRAPH" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="18" Margin="0,0,12,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="INVESTIGATION GRAPH" Foreground="{StaticResource NeonBrush}" FontSize="11"/><TextBlock Text="Connect evidence, experiments and observations." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Canvas x:Name="GraphCanvas" Background="#0B110E" ClipToBounds="True"><Line X1="125" Y1="110" X2="280" Y2="175" Stroke="#286342" StrokeThickness="2"/><Line X1="280" Y1="175" X2="390" Y2="90" Stroke="#286342" StrokeThickness="2"/><Line X1="125" Y1="110" X2="130" Y2="260" Stroke="#286342" StrokeThickness="2"/><Ellipse Canvas.Left="83" Canvas.Top="68" Width="84" Height="84" Fill="#14291D" Stroke="#65FF9A" StrokeThickness="1.5"/><TextBlock Canvas.Left="101" Canvas.Top="101" Text="CASE" Foreground="#65FF9A" FontSize="11"/><Ellipse Canvas.Left="238" Canvas.Top="135" Width="84" Height="84" Fill="#14291D" Stroke="#65FF9A" StrokeThickness="1.5"/><TextBlock Canvas.Left="254" Canvas.Top="168" Text="EVIDENCE" Foreground="#65FF9A" FontSize="10"/><Ellipse Canvas.Left="348" Canvas.Top="48" Width="84" Height="84" Fill="#14291D" Stroke="#65FF9A" StrokeThickness="1.5"/><TextBlock Canvas.Left="365" Canvas.Top="81" Text="FIELD" Foreground="#65FF9A" FontSize="11"/><Ellipse Canvas.Left="88" Canvas.Top="220" Width="84" Height="84" Fill="#14291D" Stroke="#65FF9A" StrokeThickness="1.5"/><TextBlock Canvas.Left="104" Canvas.Top="253" Text="NOTE" Foreground="#65FF9A" FontSize="11"/></Canvas></DockPanel></Border>
    <StackPanel Grid.Column="1"><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource NeonBrush}" FontSize="11" Margin="0,0,0,8"/><Button Content="+   Create investigation case" Click="NewCase_Click" HorizontalContentAlignment="Left"/><Button Content="⌁   Open relationship board" Click="Board_Click" HorizontalContentAlignment="Left"/><Button Content="&gt;_   Open local command console" Click="Terminal_Click" HorizontalContentAlignment="Left"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="18"><StackPanel><TextBlock Text="SYSTEM STATUS" Foreground="{StaticResource NeonBrush}" FontSize="11" Margin="0,0,0,12"/><TextBlock Text="● LOCAL DATABASE" Foreground="{StaticResource NeonBrush}"/><TextBlock Text="SQLite · AppData/Local/GHOST" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,12"/><TextBlock Text="● NETWORK" Foreground="{StaticResource NeonBrush}"/><TextBlock Text="No network connection required" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,12"/><TextBlock Text="! SECURITY NOTE" Foreground="#E5B567"/><TextBlock Text="Local storage is not encrypted in this initial build. Protect your Windows account and backups." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
   </Grid>
   <TextBlock Grid.Row="3" Text="GHOST // OFFLINE INVESTIGATION SUITE                                      BUILD 0.1.0 // FOUNDATION" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,18,0,0"/>
  </Grid>
 </Grid>
</Window>
