<Window x:Class="GHOST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHOST // Investigation Lab"
        Height="980" Width="1580" MinHeight="780" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource HackerFont}">
    <Window.Resources>
        <DataTemplate x:Key="RecentCaseTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CaseNumber}"
                           Foreground="{StaticResource CyanBrush}"
                           FontSize="10" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="8,0" />
                <Border Grid.Column="2" Background="#17251C" CornerRadius="4"
                        Padding="6,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Status}" FontSize="9"
                               Foreground="{StaticResource NeonBrush}" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding CreatedAt}"
                           FontSize="9" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="254" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="16,18,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10"
                                Background="#13271B" BorderBrush="#3C8658"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <Ellipse Width="27" Height="27" Stroke="{StaticResource NeonBrush}"
                                         StrokeThickness="1.2" />
                                <TextBlock Text="G" FontSize="21" Foreground="{StaticResource NeonBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="GHOST" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="INVESTIGATION OS" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18" />
                    <Border Background="#101C14" BorderBrush="#254332" BorderThickness="1"
                            CornerRadius="6" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource NeonBrush}"
                                     Margin="0,0,9,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#63FFA0" BlurRadius="9" ShadowDepth="0" Opacity="0.75" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="LOCAL SESSION ACTIVE" FontSize="9"
                                       Foreground="{StaticResource NeonBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" />
                    <Border Background="#101812" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="WORKSTATION STATUS" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,7">
                                <TextBlock Text="●" Foreground="{StaticResource NeonBrush}" FontSize="10"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="DATABASE READY" Foreground="{StaticResource TextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <TextBlock Text="●" Foreground="{StaticResource CyanBrush}" FontSize="10"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="NETWORK ISOLATED" Foreground="{StaticResource TextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <TextBlock Text="ENCRYPTION: NOT CONFIGURED" FontSize="8"
                                       Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Every trace tells a story." FontStyle="Italic" FontSize="9"
                               Foreground="{StaticResource MutedBrush}" Margin="3,14,0,0" />
                    <TextBlock Text="GHOST / BUILD 0.2" FontSize="8"
                               Foreground="#52695A" Margin="3,5,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                   Margin="5,0,0,8" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Background="#17271C" BorderBrush="#315A3C"
                                Foreground="{StaticResource NeonBrush}"
                                Content="▦   COMMAND CENTER" Click="Dashboard_Click" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Content="▤   CASE FILES" Click="Cases_Click" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Content="⌕   DIGITAL LAB" Click="ComingSoon_Click" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Content="⚗   FIELD LAB" Click="ComingSoon_Click" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Content="⬡   EVIDENCE VAULT" Click="ComingSoon_Click" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Content="⌘   INVESTIGATION NETWORK" Click="Network_Click" />

                        <TextBlock Text="TOOLS" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                   Margin="5,22,0,8" />
                        <Button Style="{StaticResource NavButtonStyle}"
                                Content="&gt;_   GHOST TERMINAL" Click="Terminal_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Column="1" Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="142" />
                <RowDefinition Height="94" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GHOST / OFFLINE FORENSICS" FontSize="9"
                               Foreground="{StaticResource NeonBrush}" />
                    <TextBlock x:Name="PageTitle" Text="Command Center" FontSize="22"
                               FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="PageEyebrow" Text="PRIVATE INVESTIGATION WORKSPACE"
                               Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="11,9" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="OFFLINE MODE" FontSize="9"
                                       Foreground="{StaticResource CyanBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="11,9" Margin="0,0,9,0">
                        <TextBlock x:Name="ClockText" Text="LOCAL // 00:00:00"
                                   FontSize="9" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <Button Content="+ NEW CASE" Click="NewCase_Click"
                            Padding="14,10" FontSize="10" />
                </StackPanel>
            </Grid>

            <!-- HERO PANEL -->
            <Border Grid.Row="1" Background="{StaticResource HeroBrush}"
                    BorderBrush="#31543B" BorderThickness="1" CornerRadius="10"
                    ClipToBounds="True" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="26,18,12,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1B3A25" CornerRadius="4" Padding="7,4"
                                    BorderBrush="#396C48" BorderThickness="1" Margin="0,0,9,0">
                                <TextBlock Text="SYSTEM READY" FontSize="8"
                                           Foreground="{StaticResource NeonBrush}" />
                            </Border>
                            <TextBlock Text="SESSION 001  /  LOCAL INSTANCE" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="INVESTIGATE THE UNKNOWN."
                                   FontSize="28" FontWeight="Bold" Margin="0,13,0,7"
                                   Foreground="#F0FFF4" />
                        <TextBlock Text="A private workspace for digital traces, physical observations, and connected evidence."
                                   FontSize="10" Foreground="#A9C1B0" TextWrapping="Wrap"
                                   MaxWidth="700" />
                    </StackPanel>
                    <Grid Grid.Column="1" ClipToBounds="True">
                        <Border Background="{StaticResource DotGridBrush}" Opacity="0.62" />
                        <Ellipse Width="210" Height="210" Stroke="#28583A" StrokeThickness="1"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-26,0" />
                        <Ellipse Width="156" Height="156" Stroke="#326D47" StrokeThickness="1"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" />
                        <Ellipse Width="94" Height="94" Stroke="{StaticResource NeonBrush}" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#63FFA0" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="G" FontSize="54" Foreground="{StaticResource NeonBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,56,2"
                                   Opacity="0.88" />
                        <TextBlock Text="TRACE // VERIFY // CONNECT" FontSize="8"
                                   Foreground="#6E9A7B" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,21,14" />
                    </Grid>
                </Grid>
            </Border>

            <!-- METRIC CARDS -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OPEN CASES" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="CasesCount" Text="0" FontSize="28"
                                       Foreground="{StaticResource NeonBrush}" Margin="0,4,0,1" />
                            <TextBlock Text="ACTIVE INVESTIGATIONS" FontSize="7"
                                       Foreground="#657D6C" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7"
                                Background="#17291C" VerticalAlignment="Top">
                            <TextBlock Text="▤" FontSize="17" Foreground="{StaticResource NeonBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="EXPERIMENTS" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="ExperimentsCount" Text="0" FontSize="28"
                                       Foreground="{StaticResource CyanBrush}" Margin="0,4,0,1" />
                            <TextBlock Text="RECORDED PROCEDURES" FontSize="7"
                                       Foreground="#657D6C" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7"
                                Background="#14272B" VerticalAlignment="Top">
                            <TextBlock Text="⌁" FontSize="20" Foreground="{StaticResource CyanBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="EVIDENCE ITEMS" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="EvidenceCount" Text="0" FontSize="28"
                                       Foreground="#D8E98A" Margin="0,4,0,1" />
                            <TextBlock Text="LOCAL VAULT RECORDS" FontSize="7"
                                       Foreground="#657D6C" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7"
                                Background="#292B1A" VerticalAlignment="Top">
                            <TextBlock Text="⬡" FontSize="17" Foreground="#D8E98A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
</UniformGrid>

            <!-- HOME WORKSPACE: no investigation-network preview on the dashboard -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- OPERATIONS DECK -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="17" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="QUICK OPERATIONS" FontSize="10"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="Your next step, one click away."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Margin="0,0,8,0" Click="NewCase_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="＋" FontSize="20"
                                               Foreground="{StaticResource NeonBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Create investigation" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Open a new case file" FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Margin="0,0,8,0" Click="Cases_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▤" FontSize="17"
                                               Foreground="{StaticResource CyanBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Browse case archive" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Review saved investigations" FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Margin="0" Click="Terminal_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&gt;_" FontSize="14"
                                               Foreground="{StaticResource NeonBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="GHOST terminal" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Local console module" FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!-- RECENT CASES -->
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="17" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RECENT CASE FILES" FontSize="10"
                                           Foreground="{StaticResource NeonBrush}" />
                                <TextBlock Text="The latest records in your local workspace"
                                           FontSize="8" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="VIEW ALL  →"
                                    Style="{StaticResource NavButtonStyle}" Click="Cases_Click"
                                    Padding="8,4" Margin="0" FontSize="8" />
                        </Grid>
                        <Grid>
                            <ListBox x:Name="RecentCasesList"
                                     ItemTemplate="{StaticResource RecentCaseTemplate}"
                                     Background="Transparent" BorderThickness="0" />
                            <StackPanel x:Name="EmptyCasesHint" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="NO CASES YET" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Create an investigation to populate this space."
                                           FontSize="8" Foreground="#607768" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- LOCAL INTEGRITY -->
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="17">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE INTEGRITY" FontSize="10"
                                   Foreground="{StaticResource NeonBrush}" />
                        <Grid Margin="0,12,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource NeonBrush}"
                                     VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LOCAL DATABASE" FontSize="9" />
                                <TextBlock Text="%LOCALAPPDATA%\GHOST\GHOST.db"
                                           FontSize="8" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="!" FontSize="10"
                                       Foreground="{StaticResource AmberBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Evidence is stored locally, but encryption at rest is not configured yet. Avoid sensitive material until security hardening is complete."
                                       FontSize="8" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" LineHeight="14" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
