<Window x:Class="GHOST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHOST // Investigation Lab"
        Height="820" Width="1360" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource HackerFont}">
    <Window.Resources>
        <DataTemplate x:Key="RecentCaseTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CaseNumber}"
                           Foreground="{StaticResource CyanBrush}"
                           FontSize="10" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="8,0" />
                <Border Grid.Column="2" Background="#17251C" CornerRadius="4"
                        Padding="6,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Status}" FontSize="9"
                               Foreground="{StaticResource NeonBrush}" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding CreatedAt}"
                           FontSize="9" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="254" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="16,18,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10"
                                Background="#13271B" BorderBrush="#3C8658"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <Ellipse Width="27" Height="27" Stroke="{StaticResource NeonBrush}"
                                         StrokeThickness="1.2" />
                                <TextBlock Text="G" FontSize="21" Foreground="{StaticResource NeonBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="GHOST" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="INVESTIGATION OS" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18" />
                    <Border Background="#101C14" BorderBrush="#254332" BorderThickness="1"
                            CornerRadius="6" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource NeonBrush}"
                                     Margin="0,0,9,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#63FFA0" BlurRadius="9" ShadowDepth="0" Opacity="0.75" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="LOCAL SESSION ACTIVE" FontSize="9"
                                       Foreground="{StaticResource NeonBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" />
                    <Border Background="#101812" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="WORKSTATION STATUS" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,7">
                                <TextBlock Text="●" Foreground="{StaticResource NeonBrush}" FontSize="10"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="DATABASE READY" Foreground="{StaticResource TextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <TextBlock Text="●" Foreground="{StaticResource CyanBrush}" FontSize="10"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="NETWORK ISOLATED" Foreground="{StaticResource TextBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <TextBlock Text="ENCRYPTION: NOT CONFIGURED" FontSize="8"
                                       Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Every trace tells a story." FontStyle="Italic" FontSize="9"
                               Foreground="{StaticResource MutedBrush}" Margin="3,14,0,0" />
                    <TextBlock Text="GHOST / BUILD 0.2" FontSize="8"
                               Foreground="#52695A" Margin="3,5,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                   Margin="5,0,0,8" />
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}"
                                Content="▦   COMMAND CENTER" Click="Dashboard_Click" />
                        <Button x:Name="NavCases" Style="{StaticResource NavButtonStyle}"
                                Content="▤   CASE FILES" Click="Cases_Click" />
                        <Button x:Name="NavDigitalLab" Style="{StaticResource NavButtonStyle}"
                                Content="⌕   DIGITAL LAB" Click="DigitalLab_Click" />
                        <Button x:Name="NavFieldLab" Style="{StaticResource NavButtonStyle}"
                                Content="⚗   FIELD LAB" Click="FieldLab_Click" />
                        <Button x:Name="NavEvidenceVault" Style="{StaticResource NavButtonStyle}"
                                Content="⬡   EVIDENCE VAULT" Click="EvidenceVault_Click" />
                        <Button x:Name="NavNetwork" Style="{StaticResource NavButtonStyle}"
                                Content="⌘   INVESTIGATION NETWORK" Click="Network_Click" />

                        <TextBlock Text="TOOLS" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                   Margin="5,22,0,8" />
                        <Button x:Name="NavTerminal" Style="{StaticResource NavButtonStyle}"
                                Content="&gt;_   GHOST TERMINAL" Click="Terminal_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid x:Name="DashboardView" Grid.Column="1" Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="150" />
                <RowDefinition Height="108" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GHOST / INVESTIGATION OPERATIONS" FontSize="9"
                               Foreground="{StaticResource NeonBrush}" />
                    <TextBlock x:Name="PageTitle" Text="Command Center" FontSize="22"
                               FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="PageEyebrow" Text="PRIVATE INVESTIGATION WORKSPACE"
                               Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="11,9" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="OFFLINE MODE" FontSize="9"
                                       Foreground="{StaticResource CyanBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="11,9" Margin="0,0,9,0">
                        <TextBlock x:Name="ClockText" Text="LOCAL // 00:00:00"
                                   FontSize="9" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <Button Content="+ NEW CASE" Click="NewCase_Click"
                            Padding="14,10" FontSize="10" />
                </StackPanel>
            </Grid>

            <!-- LIVE SYSTEM MONITOR: real Windows telemetry -->
            <Border Grid.Row="1" Background="#081711"
                    BorderBrush="#244B35" BorderThickness="1" CornerRadius="10"
                    ClipToBounds="True" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="2" Height="3" VerticalAlignment="Top"
                            Background="#63FFA0" />

                    <!-- Host and operating-system status -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,8,12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#63FFA0"
                                     Margin="0,0,7,0" />
                            <TextBlock Text="LIVE SYSTEM TELEMETRY" FontSize="8"
                                       Foreground="#9DFFC1" />
                        </StackPanel>
                        <TextBlock Text="SYSTEM MONITOR" FontSize="18"
                                   FontWeight="Bold" Margin="0,7,0,4"
                                   Foreground="#F1F7FC" />
                        <TextBlock x:Name="SystemHostText" Text="HOST / DETECTING DEVICE"
                                   FontSize="8" Foreground="#BDD9C6"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SystemUptimeText" Text="UPTIME / READING..."
                                   FontSize="8" Foreground="#86B398" Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- Live metrics -->
                    <Grid Grid.Column="1" Margin="0,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0C1D14"
                                BorderBrush="#21442E" BorderThickness="1" CornerRadius="6"
                                Margin="0,0,7,0" Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CPU LOAD" FontSize="8"
                                           Foreground="#9DFFC1" />
                                <TextBlock x:Name="CpuUsageText" Text="--%"
                                           FontSize="23" FontWeight="SemiBold"
                                           Foreground="#63FFA0" Margin="0,2,0,3" />
                                <Grid Height="31" Margin="0,1,0,1" ClipToBounds="True">
                                    <Rectangle Height="1" Fill="#1C3B29"
                                               VerticalAlignment="Center" Opacity="0.8" />
                                    <Path x:Name="CpuUsageSparklineFill"
                                          Stretch="Fill" Fill="#1D7A49" Opacity="0.42"
                                          StrokeThickness="0" Data="M 0,34 L 100,34 Z" />
                                    <Path x:Name="CpuUsageSparklineGlow"
                                          Stretch="Fill" Stroke="#35FF95" StrokeThickness="4"
                                          Opacity="0.20" Data="M 0,17 L 100,17" />
                                    <Path x:Name="CpuUsageSparkline"
                                          Stretch="Fill" Stroke="#63FFA0" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Data="M 0,17 L 100,17" />
                                </Grid>
                                <TextBlock x:Name="CpuUsageDetailText" Text="Sampling CPU activity..."
                                           FontSize="7" Foreground="#88AB94"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0C1D14"
                                BorderBrush="#21442E" BorderThickness="1" CornerRadius="6"
                                Margin="0,0,7,0" Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MEMORY / RAM" FontSize="8"
                                           Foreground="#9DFFC1" />
                                <TextBlock x:Name="MemoryUsageText" Text="--%"
                                           FontSize="23" FontWeight="SemiBold"
                                           Foreground="#63FFA0" Margin="0,2,0,3" />
                                <Grid Height="31" Margin="0,1,0,1" ClipToBounds="True">
                                    <Rectangle Height="1" Fill="#1C3B29"
                                               VerticalAlignment="Center" Opacity="0.8" />
                                    <Path x:Name="MemoryUsageSparklineFill"
                                          Stretch="Fill" Fill="#1D7A49" Opacity="0.42"
                                          StrokeThickness="0" Data="M 0,34 L 100,34 Z" />
                                    <Path x:Name="MemoryUsageSparklineGlow"
                                          Stretch="Fill" Stroke="#35FF95" StrokeThickness="4"
                                          Opacity="0.20" Data="M 0,17 L 100,17" />
                                    <Path x:Name="MemoryUsageSparkline"
                                          Stretch="Fill" Stroke="#63FFA0" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Data="M 0,17 L 100,17" />
                                </Grid>
                                <TextBlock x:Name="MemoryUsageDetailText" Text="Reading physical memory..."
                                           FontSize="7" Foreground="#88AB94"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0C1D14"
                                BorderBrush="#21442E" BorderThickness="1" CornerRadius="6"
                                Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM DRIVE" FontSize="8"
                                           Foreground="#9DFFC1" />
                                <TextBlock x:Name="DiskUsageText" Text="--%"
                                           FontSize="23" FontWeight="SemiBold"
                                           Foreground="#63FFA0" Margin="0,2,0,3" />
                                <Grid Height="31" Margin="0,1,0,1" ClipToBounds="True">
                                    <Rectangle Height="1" Fill="#1C3B29"
                                               VerticalAlignment="Center" Opacity="0.8" />
                                    <Path x:Name="DiskUsageSparklineFill"
                                          Stretch="Fill" Fill="#1D7A49" Opacity="0.42"
                                          StrokeThickness="0" Data="M 0,34 L 100,34 Z" />
                                    <Path x:Name="DiskUsageSparklineGlow"
                                          Stretch="Fill" Stroke="#35FF95" StrokeThickness="4"
                                          Opacity="0.20" Data="M 0,17 L 100,17" />
                                    <Path x:Name="DiskUsageSparkline"
                                          Stretch="Fill" Stroke="#63FFA0" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Data="M 0,17 L 100,17" />
                                </Grid>
                                <TextBlock x:Name="DiskUsageDetailText" Text="Reading system drive..."
                                           FontSize="7" Foreground="#88AB94"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- METRIC CARDS -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource NeonBrush}" CornerRadius="8,8,0,0" />
                        <Grid Grid.Row="1" Margin="14,9,12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="OPEN CASES" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="CasesCount" Text="0" FontSize="27" FontWeight="SemiBold"
                                           Foreground="{StaticResource NeonBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="ACTIVE INVESTIGATIONS" FontSize="7" Foreground="#718878" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                                    Background="#17291C" VerticalAlignment="Top">
                                <TextBlock Text="▤" FontSize="17" Foreground="{StaticResource NeonBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FF5C68" CornerRadius="8,8,0,0" />
                        <Grid Grid.Row="1" Margin="14,9,12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CLOSED CASES" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="ClosedCasesCount" Text="0" FontSize="27" FontWeight="SemiBold"
                                           Foreground="#FF7A83" Margin="0,2,0,0" />
                                <TextBlock Text="COMPLETED INVESTIGATIONS" FontSize="7" Foreground="#B97980" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                                    Background="#35181D" VerticalAlignment="Top">
                                <TextBlock Text="✓" FontSize="17" Foreground="#FF7A83"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource CyanBrush}" CornerRadius="8,8,0,0" />
                        <Grid Grid.Row="1" Margin="14,9,12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="EXPERIMENTS" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="ExperimentsCount" Text="0" FontSize="27" FontWeight="SemiBold"
                                           Foreground="{StaticResource CyanBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="RECORDED PROCEDURES" FontSize="7" Foreground="#718878" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                                    Background="#14272B" VerticalAlignment="Top">
                                <TextBlock Text="⌁" FontSize="20" Foreground="{StaticResource CyanBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#D8E98A" CornerRadius="8,8,0,0" />
                        <Grid Grid.Row="1" Margin="14,9,12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="EVIDENCE ITEMS" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="EvidenceCount" Text="0" FontSize="27" FontWeight="SemiBold"
                                           Foreground="#D8E98A" Margin="0,2,0,0" />
                                <TextBlock Text="ACTIVE VAULT RECORDS" FontSize="7" Foreground="#718878" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                                    Background="#292B1A" VerticalAlignment="Top">
                                <TextBlock Text="⬡" FontSize="17" Foreground="#D8E98A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- HOME WORKSPACE: no investigation-network preview on the dashboard -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- OPERATIONS DECK -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="17" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="QUICK OPERATIONS" FontSize="10"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="Start a case, review your archive, or continue analysis."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Margin="0,0,8,0" Click="NewCase_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="＋" FontSize="20"
                                               Foreground="{StaticResource NeonBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Create investigation" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Open a new case file" FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Margin="0,0,8,0" Click="Cases_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▤" FontSize="17"
                                               Foreground="{StaticResource CyanBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Browse case archive" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Review saved investigations" FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PanelActionButtonStyle}"
                                    Margin="0" Click="DigitalLab_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚗" FontSize="18"
                                               Foreground="{StaticResource CyanBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Open Digital Lab" FontSize="10"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Document methods and findings" FontSize="8"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!-- RECENT CASES -->
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="17" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RECENT CASE FILES" FontSize="10"
                                           Foreground="{StaticResource NeonBrush}" />
                                <TextBlock Text="Select a record and open it, or double-click its row."
                                           FontSize="8" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenRecentCaseButton" Content="OPEN SELECTED"
                                        Click="OpenRecentCase_Click" IsEnabled="False"
                                        Style="{StaticResource NavButtonStyle}"
                                        Padding="9,5" Margin="0,0,5,0" FontSize="8" />
                                <Button Content="VIEW ALL  →"
                                        Style="{StaticResource NavButtonStyle}" Click="Cases_Click"
                                        Padding="8,5" Margin="0" FontSize="8" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <ListBox x:Name="RecentCasesList"
                                     ItemTemplate="{StaticResource RecentCaseTemplate}"
                                     Background="Transparent" BorderThickness="0"
                                     SelectionChanged="RecentCasesList_SelectionChanged"
                                     MouseDoubleClick="RecentCase_DoubleClick" />
                            <StackPanel x:Name="EmptyCasesHint" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="NO CASES YET" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Create an investigation to populate this space."
                                           FontSize="8" Foreground="#607768" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- GHOST SHELL: compact PowerShell-inspired, read-only local console -->
                <Border Grid.Row="1" Grid.Column="1"
                        Background="#050906" BorderBrush="#315C3D" BorderThickness="1"
                        CornerRadius="8" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <!-- Terminal chrome -->
                        <Border Grid.Row="0" Background="#111A13"
                                BorderBrush="#25452D" BorderThickness="0,0,0,1">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,9,0">
                                    <Ellipse Width="7" Height="7" Fill="#63FFA0" Margin="0,0,4,0" />
                                    <Ellipse Width="7" Height="7" Fill="#36734A" Margin="0,0,4,0" />
                                    <Ellipse Width="7" Height="7" Fill="#244B31" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GHOST SHELL" FontSize="9"
                                               FontWeight="SemiBold" Foreground="#BFFFD0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#14291A"
                                        BorderBrush="#28563A" BorderThickness="1"
                                        CornerRadius="3" Padding="6,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="READ-ONLY" FontSize="7"
                                               Foreground="#63FFA0" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Scrollable command history -->
                        <ScrollViewer x:Name="DashboardConsoleScrollViewer" Grid.Row="1"
                                      Background="#050906"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DashboardConsoleOutputPanel"
                                        Margin="11,8,9,3" />
                        </ScrollViewer>

                        <!-- Command prompt -->
                        <Border Grid.Row="2" Background="#0B130D"
                                BorderBrush="#23472E" BorderThickness="0,1,0,0"
                                Padding="9,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PS&gt;" FontSize="10" FontWeight="Bold"
                                           Foreground="#63FFA0" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox x:Name="DashboardConsoleInput" Grid.Column="1"
                                         Height="28" Padding="7,4"
                                         Background="#050906" BorderBrush="#25472E"
                                         BorderThickness="1" Foreground="#C8F8D4"
                                         CaretBrush="#63FFA0" FontSize="9"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Type help, status, system, cases, evidence, labs, uptime, host, time, or clear"
                                         KeyDown="DashboardConsoleInput_KeyDown" />
                                <Button Grid.Column="2" Content="RUN  ↵"
                                        Click="DashboardConsoleRun_Click"
                                        Padding="8,5" FontSize="8"
                                        Margin="6,0,0,0" Background="#14291A"
                                        BorderBrush="#2C6840" Foreground="#8FFFB1" />
                            </Grid>
                        </Border>

                        <!-- Safe mode indicator -->
                        <Border Grid.Row="3" Background="#0B130D" Padding="10,1">
                            <TextBlock Text="LOCAL DIAGNOSTICS ONLY  //  NO OS COMMAND EXECUTION"
                                       FontSize="7" Foreground="#668A70"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    <Grid x:Name="NetworkView" Grid.Column="1" Margin="26,20,26,22" Visibility="Collapsed">
        <Grid.Resources>
        <DataTemplate x:Key="ConnectionTemplate">
            <Border Background="#0D1711" BorderBrush="#263E30" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,7">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RelationshipType}" FontSize="9"
                                   Foreground="{StaticResource NeonBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" FontSize="8"
                                   Foreground="{StaticResource CyanBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding SourceLabel}" FontSize="9"
                               Foreground="{StaticResource TextBrush}" Margin="0,7,0,2"
                               TextWrapping="Wrap" />
                    <TextBlock Text="↓" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TargetLabel}" FontSize="9"
                               Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DescriptionPreview}" FontSize="8"
                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GHOST / WORKSPACE / VISUAL ANALYSIS" FontSize="9"
                           Foreground="{StaticResource NeonBrush}" />
                <TextBlock Text="Investigation Network" FontSize="23"
                           FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#101B15" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="LOCAL DATA" FontSize="9"
                                   Foreground="{StaticResource CyanBrush}" />
                    </StackPanel>
                </Border>
                <Button Content="↻ REFRESH" Click="Refresh_Click" Margin="0,0,8,0" />
                <Button x:Name="NewRelationshipButton" Content="+ CREATE CONNECTION"
                        Click="NewRelationship_Click" Margin="0,0,8,0" />
                <Button Content="← COMMAND CENTER" Click="Dashboard_Click" />
            </StackPanel>
        </Grid>

        <!-- NETWORK AND RIGHT SIDEBAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <!-- GRAPH VIEW -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="16" Margin="0,0,13,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RELATIONSHIP MAP" FontSize="10"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="Nodes are loaded from your saved case and evidence records."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Background="#13241A" BorderBrush="#31543B" BorderThickness="1"
                                    CornerRadius="5" Padding="8,5" Margin="0,0,7,0">
                                <TextBlock x:Name="NodesCountText" Text="NODES // 0" FontSize="8"
                                           Foreground="{StaticResource NeonBrush}" />
                            </Border>
                            <Border Background="#132126" BorderBrush="#2A5360" BorderThickness="1"
                                    CornerRadius="5" Padding="8,5">
                                <TextBlock x:Name="RelationshipsCountText" Text="LINKS // 0" FontSize="8"
                                           Foreground="{StaticResource CyanBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GraphSearchBox" Height="34"
                                 ToolTip="Search node title, ID, record type, or details"
                                 TextChanged="GraphFilter_Changed"
                                 Margin="0,0,8,0" />
                        <ComboBox x:Name="GraphTypeFilter" Grid.Column="1" Height="34"
                                  SelectionChanged="GraphFilter_Changed"
                                  Margin="0,0,8,0">
                            <ComboBoxItem Content="All record types" IsSelected="True" />
                            <ComboBoxItem Content="Cases" />
                            <ComboBoxItem Content="Evidence" />
                            <ComboBoxItem Content="Experiments" />
                            <ComboBoxItem Content="Observations" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="−" Width="38" ToolTip="Zoom out"
                                    Click="GraphZoomOut_Click" Margin="0,0,5,0" />
                            <Button Content="FIT" MinWidth="52" ToolTip="Fit graph to view"
                                    Click="GraphFit_Click" Margin="0,0,5,0" />
                            <Button Content="+" Width="38" ToolTip="Zoom in"
                                    Click="GraphZoomIn_Click" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#08110C" BorderBrush="#1D3024" BorderThickness="1"
                            CornerRadius="7" Padding="4">
                        <Grid>
                            <ScrollViewer x:Name="GraphScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="GraphCanvas" Width="1100" Height="600"
                                        Background="{StaticResource DotGridBrush}" />
                            </ScrollViewer>
                            <Border x:Name="EmptyGraphOverlay" Background="#E008110C"
                                    CornerRadius="6" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="390">
                                    <TextBlock x:Name="GraphEmptyTitle" Text="NO INVESTIGATION NODES" FontSize="12"
                                               Foreground="{StaticResource NeonBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Create case records from the Command Center first. They will appear here automatically. As more evidence and experiments are added, they can be connected into your map."
                                               FontSize="9" Foreground="{StaticResource MutedBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Margin="0,11,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- CONTROLS AND SAVED LINKS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SELECTED NODE" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="SelectedNodeTitle" Text="Select a node on the map"
                                   FontSize="12" Foreground="{StaticResource NeonBrush}"
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock x:Name="SelectedNodeDetails"
                                   Text="Click a node to inspect its local record."
                                   FontSize="8" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14" />
                        <Button x:Name="OpenSelectedNodeButton" Content="OPEN SELECTED RECORD"
                                Click="OpenSelectedNode_Click" IsEnabled="False"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HOW THIS MAP WORKS" FontSize="9"
                                   Foreground="{StaticResource NeonBrush}" />
                        <TextBlock Text="Create connections between saved records. Relationship type, notes, and confidence are kept locally. Dashed links represent a hypothesis or contradiction."
                                   FontSize="8" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="14" />
                    </StackPanel>
                </Border>

                <!-- INLINE CONNECTION EDITOR: stays inside the main application window -->
                <Border x:Name="CreateConnectionPanel" Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#31543B" BorderThickness="1"
                        CornerRadius="8" Padding="13" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="CREATE CONNECTION" FontSize="9"
                                   Foreground="{StaticResource NeonBrush}" />
                        <TextBlock Text="Connect two records. A link represents an investigator-created assertion, not automatic proof."
                                   FontSize="8" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,9" />
                        <TextBlock Text="SOURCE RECORD" FontSize="8" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="SourceRecordComboBox" Height="32"
                                  DisplayMemberPath="DisplayText" FontSize="9"
                                  Margin="0,3,0,7" />
                        <TextBlock Text="TARGET RECORD" FontSize="8" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="TargetRecordComboBox" Height="32"
                                  DisplayMemberPath="DisplayText" FontSize="9"
                                  Margin="0,3,0,7" />
                        <TextBlock Text="RELATIONSHIP TYPE" FontSize="8" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="RelationshipTypeComboBox" Height="32"
                                  SelectedIndex="0" FontSize="9" Margin="0,3,0,7">
                            <ComboBoxItem Content="Related to" />
                            <ComboBoxItem Content="Supports" />
                            <ComboBoxItem Content="Contradicts" />
                            <ComboBoxItem Content="Derived from" />
                            <ComboBoxItem Content="Part of" />
                            <ComboBoxItem Content="Same source" />
                            <ComboBoxItem Content="Observed with" />
                            <ComboBoxItem Content="Hypothesis" />
                        </ComboBox>
                        <TextBlock Text="NOTES / SOURCE / REASONING" FontSize="8"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="RelationshipNotesTextBox" Height="55"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="9"
                                 Margin="0,3,0,7" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONFIDENCE (INVESTIGATOR ESTIMATE)" FontSize="8"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ConfidenceValueText" Grid.Column="1"
                                       Text="80%" FontSize="9"
                                       Foreground="{StaticResource CyanBrush}" />
                        </Grid>
                        <Slider x:Name="ConfidenceSlider" Minimum="0" Maximum="1" Value="0.8"
                                TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_ValueChanged" />
                        <TextBlock x:Name="CreateConnectionStatus" FontSize="8"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="0,3,0,5" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Width="82" Click="CancelRelationship_Click"
                                    Margin="0,0,7,0" />
                            <Button Content="SAVE CONNECTION" Width="145"
                                    Click="SaveRelationship_Click" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                            <TextBlock Text="SAVED CONNECTIONS" FontSize="9"
                                       Foreground="{StaticResource NeonBrush}" />
                            <TextBlock Text="Select a connection to inspect its notes."
                                       FontSize="8" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid>
                            <ListBox x:Name="ConnectionsList"
                                     ItemTemplate="{StaticResource ConnectionTemplate}"
                                     SelectionChanged="ConnectionsList_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" />
                            <TextBlock x:Name="EmptyConnectionsHint"
                                       Text="No connections yet. Use CREATE CONNECTION to link two records."
                                       FontSize="8" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="8" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Button x:Name="DeleteConnectionButton" Grid.Row="4"
                        Content="DELETE SELECTED CONNECTION" Click="DeleteConnection_Click"
                        IsEnabled="False" Background="#2B1414" Foreground="#FFAAAA"
                        BorderBrush="#633737" Padding="12,10" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
    <Grid x:Name="ModuleView" Grid.Column="1" Margin="26,20,26,22" Visibility="Collapsed">
        <ContentControl x:Name="ModuleContent" />
    </Grid>
    </Grid>
</Window>
