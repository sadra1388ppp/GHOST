<Application x:Class="GHOST.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="BgColor">#080C0B</Color><Color x:Key="PanelColor">#101715</Color><Color x:Key="PanelAltColor">#151F1B</Color><Color x:Key="NeonColor">#65FF9A</Color><Color x:Key="MutedColor">#82968A</Color><Color x:Key="LineColor">#263B30</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}"/><SolidColorBrush x:Key="NeonBrush" Color="{StaticResource NeonColor}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/><SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7F5EB"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource NeonBrush}"/><Setter Property="Background" Value="#15251C"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/></Style>
  </Application.Resources>
</Application>
